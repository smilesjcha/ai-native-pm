{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "$description": "AI-Native PM Design System — Apple-inspired tokens (source of truth). Derived from docs/design-system/DESIGN.md. W3C Design Tokens format.",
  "$meta": {
    "name": "apple-md",
    "version": "1.0.0",
    "basedOn": "getdesign.md / Apple design-md",
    "lastUpdated": "2026-06-26",
    "author": "PM 차성재 with Claude Opus 4.8"
  },
  "color": {
    "$type": "color",
    "brand": {
      "action-blue":   { "$value": "#0066cc", "$description": "단일 브랜드 인터랙티브 컬러. 모든 링크/CTA/포커스" },
      "focus-blue":    { "$value": "#0071e3", "$description": "키보드 포커스 링 전용" },
      "sky-link-blue": { "$value": "#2997ff", "$description": "다크 표면 위 인라인 링크" }
    },
    "ink": {
      "default":   { "$value": "#1d1d1f", "$description": "헤드라인·본문 (순흑 대신 near-black)" },
      "muted-80":  { "$value": "#333333" },
      "muted-48":  { "$value": "#7a7a7a", "$description": "비활성·법적 fine print" }
    },
    "surface": {
      "canvas":       { "$value": "#ffffff", "$description": "기본 캔버스" },
      "parchment":    { "$value": "#f5f5f7", "$description": "Apple 시그니처 off-white" },
      "pearl":        { "$value": "#fafafc", "$description": "secondary 버튼 fill" },
      "tile-1":       { "$value": "#272729", "$description": "기본 다크 타일" },
      "tile-2":       { "$value": "#2a2a2c" },
      "tile-3":       { "$value": "#252527" },
      "black":        { "$value": "#000000", "$description": "글로벌 nav·비디오 배경" },
      "chip-translucent": { "$value": "#d2d2d7", "$description": "사진 위 투명 칩 (~64% alpha)" }
    },
    "text": {
      "on-primary":  { "$value": "#ffffff" },
      "on-dark":     { "$value": "#ffffff" },
      "body":        { "$value": "#1d1d1f" },
      "body-muted":  { "$value": "#cccccc", "$description": "다크 타일 위 보조 카피" }
    },
    "line": {
      "divider-soft": { "$value": "#f0f0f0", "$description": "secondary 버튼 ring" },
      "hairline":     { "$value": "#e0e0e0", "$description": "유틸리티 카드 1px border" }
    }
  },
  "font": {
    "family": {
      "display": { "$type": "fontFamily", "$value": ["SF Pro Display", "system-ui", "-apple-system", "Inter", "sans-serif"], "$description": "헤드라인 (≥19px)" },
      "text":    { "$type": "fontFamily", "$value": ["SF Pro Text", "system-ui", "-apple-system", "Inter", "sans-serif"], "$description": "본문·UI" },
      "mono":    { "$type": "fontFamily", "$value": ["SF Mono", "ui-monospace", "Consolas", "monospace"] }
    },
    "weight": {
      "light":     { "$type": "fontWeight", "$value": 300, "$description": "rare — airy 전용" },
      "regular":   { "$type": "fontWeight", "$value": 400 },
      "semibold":  { "$type": "fontWeight", "$value": 600, "$description": "헤드라인 표준 (500은 의도적 부재)" },
      "bold":      { "$type": "fontWeight", "$value": 700 }
    }
  },
  "typography": {
    "$type": "typography",
    "hero-display": { "$value": { "fontFamily": "{font.family.display}", "fontSize": "56px", "fontWeight": 600, "lineHeight": 1.07, "letterSpacing": "-0.28px" } },
    "display-lg":   { "$value": { "fontFamily": "{font.family.display}", "fontSize": "40px", "fontWeight": 600, "lineHeight": 1.1,  "letterSpacing": "0" } },
    "display-md":   { "$value": { "fontFamily": "{font.family.text}",    "fontSize": "34px", "fontWeight": 600, "lineHeight": 1.47, "letterSpacing": "-0.374px" } },
    "lead":         { "$value": { "fontFamily": "{font.family.display}", "fontSize": "28px", "fontWeight": 400, "lineHeight": 1.14, "letterSpacing": "0.196px" } },
    "lead-airy":    { "$value": { "fontFamily": "{font.family.text}",    "fontSize": "24px", "fontWeight": 300, "lineHeight": 1.5,  "letterSpacing": "0" } },
    "tagline":      { "$value": { "fontFamily": "{font.family.display}", "fontSize": "21px", "fontWeight": 600, "lineHeight": 1.19, "letterSpacing": "0.231px" } },
    "body-strong":  { "$value": { "fontFamily": "{font.family.text}",    "fontSize": "17px", "fontWeight": 600, "lineHeight": 1.24, "letterSpacing": "-0.374px" } },
    "body":         { "$value": { "fontFamily": "{font.family.text}",    "fontSize": "17px", "fontWeight": 400, "lineHeight": 1.47, "letterSpacing": "-0.374px" } },
    "caption":      { "$value": { "fontFamily": "{font.family.text}",    "fontSize": "14px", "fontWeight": 400, "lineHeight": 1.43, "letterSpacing": "-0.224px" } },
    "caption-strong": { "$value": { "fontFamily": "{font.family.text}",  "fontSize": "14px", "fontWeight": 600, "lineHeight": 1.29, "letterSpacing": "-0.224px" } },
    "fine-print":   { "$value": { "fontFamily": "{font.family.text}",    "fontSize": "12px", "fontWeight": 400, "lineHeight": 1.0,  "letterSpacing": "-0.12px" } }
  },
  "radius": {
    "$type": "dimension",
    "none": { "$value": "0px" },
    "xs":   { "$value": "5px" },
    "sm":   { "$value": "8px",  "$description": "다크 유틸 버튼" },
    "md":   { "$value": "11px", "$description": "pearl capsule" },
    "lg":   { "$value": "18px", "$description": "유틸리티 카드" },
    "pill": { "$value": "9999px", "$description": "시그니처 pill CTA" },
    "full": { "$value": "9999px" }
  },
  "spacing": {
    "$type": "dimension",
    "xxs":     { "$value": "4px" },
    "xs":      { "$value": "8px",  "$description": "base unit" },
    "sm":      { "$value": "12px" },
    "md":      { "$value": "17px", "$description": "본문 line-height 기준" },
    "lg":      { "$value": "24px", "$description": "카드 패딩" },
    "xl":      { "$value": "32px" },
    "xxl":     { "$value": "48px" },
    "section": { "$value": "80px", "$description": "타일 수직 패딩" }
  },
  "shadow": {
    "$type": "shadow",
    "product": { "$value": { "color": "rgba(0,0,0,0.22)", "offsetX": "3px", "offsetY": "5px", "blur": "30px", "spread": "0px" }, "$description": "시스템 유일의 드롭섀도 — 제품 이미지 전용" }
  },
  "effect": {
    "backdrop-blur": { "$type": "other", "$value": "saturate(180%) blur(20px)", "$description": "frosted sub-nav / sticky bar" },
    "press-scale":   { "$type": "other", "$value": "scale(0.95)", "$description": "전 버튼 공통 active 마이크로 인터랙션" }
  },
  "breakpoint": {
    "$type": "dimension",
    "small-phone":     { "$value": "419px" },
    "phone":           { "$value": "640px" },
    "tablet-portrait": { "$value": "734px" },
    "tablet-landscape":{ "$value": "833px" },
    "small-desktop":   { "$value": "1068px" },
    "desktop":         { "$value": "1440px" }
  }
}
